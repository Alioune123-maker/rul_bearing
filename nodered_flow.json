  "func": "if (msg.topic === 'reset') {\n  ['t', 'e'].forEach(k => flow.set(k, 0)); flow.set('run', false);\n  return [ { payload: [] }, { payload: \"Réinitialisé\" } ];\n}\nflow.set(msg.topic, msg.payload); return null;",
