 {
  "id": "sensor",
  "type": "function",
  "z": "tab1",
  "name": "Capteur simulé (RMS)",
  "func": "// Capteur simulé : RMS vibratoire horizontal d'un roulement (g), 1 échantillon par tick.\nif (!flow.get('run')) return null;\nlet t = (flow.get('t') || 0) + 1; flow.set('t', t);\nconst life = flow.get('life') || 1500, noiseGain = flow.get('noise') || 1;\nconst drift = flow.get('drift') || false, FT = 8, base = 0.5, amp = 0.3;\nconst onset = Math.floor(0.5 * life);\nconst tau = Math.max(0, t - onset);\nconst k = Math.log(1 + (FT - base) / amp) / (life - onset);\nconst clean = base + amp * (Math.exp(k * tau) - 1);\nfunction gauss() { return Math.sqrt(-2 * Math.log(1 - Math.random())) * Math.cos(2 * Math.PI * Math.random()); }\nlet e = 0.6 * (flow.get('e') || 0) + 0.06 * noiseGain * gauss(); flow.set('e', e);\nlet x = clean * Math.exp(e) + 0.03 * noiseGain * gauss();\nif (Math.random() < 0.004) x += 0.5 + 1.5 * Math.random();     // choc parasite\nif (drift) x += 0.0015 * t;                                      // défaut capteur : dérive lente\nx = Math.max(0.05, x);\nif (t >= life) {                                                  // défaillance réelle\n  flow.set('run', false);\n  return [null, { payload: \"DÉFAILLANCE du roulement à t = \" + t }];\n}\nmsg.payload = { x: x }; msg.headers = { 'Content-Type': 'application/json' };\nreturn [msg, null];",
  "outputs": 2,
  "noerr": 0,
  "x": 380,
  "y": 120,
  "wires": [
   [
    "http"
   ],
   [
    "status"
   ]
  ]
 },
 {
  "id": "http",
  "type": "http request",
  "z": "tab1",
  "name": "API Python /sample",
  "method": "POST",
  "ret": "obj",
  "paytoqs": "ignore",
  "url": "http://localhost:5000/sample",
  "tls": "",
  "persist": false,
  "proxy": "",
  "insecureHTTPParser": false,
  "authType": "",
  "senderr": false,
  "headers": [],
  "x": 640,
  "y": 120,
  "wires": [
   [
    "fmt"
   ]
  ]
 },
 {
  "id": "fmt",
  "type": "function",
  "z": "tab1",
  "name": "Mise en forme + décision",
  "func": "const r = msg.payload; if (!r || r.t === undefined) return null;\nconst pol = flow.get('policy') || 'q10';\nconst rul = Math.round(r[pol]), at = r['intervene_at_' + pol], alarm = r['alarm_' + pol];\nconst ts = Date.now(), r0 = v => Math.round(v * 100) / 100;\nconst hi  = [{ topic: 'Indicateur de santé (RMS lissé)', payload: r0(r.hi) }, { topic: 'Seuil de fin de vie', payload: r.ft }];\nconst rulc = [{ topic: 'RUL q10 (prudent)', payload: Math.round(r.q10) }, { topic: 'RUL médiane', payload: Math.round(r.q50) }, { topic: 'RUL q90 (optimiste)', payload: Math.min(3000, Math.round(r.q90)) }];\nconst status = alarm ? \"⚠ INTERVENIR MAINTENANT (règle \" + pol + \")\"\n  : \"Intervention conseillée à t = \" + at + \"  (dans \" + (at - r.t) + \" pas, règle \" + pol + \", délai logistique \" + r.delta + \")\";\nconst info = \"t = \" + r.t + \" | \" + (r.mode === 'model' ? \"modèle ajusté sur la dégradation\" : \"pas de dégradation détectée → prior de population\") +\n             \" | RUL \" + Math.round(r.q10) + \" – \" + Math.round(r.q50) + \" – \" + Math.round(Math.min(r.q90, 9999)) + \" (q10 – méd. – q90)\";\nreturn [hi, rulc, { payload: rul }, { payload: status }, { payload: info }];",
  "outputs": 5,
  "noerr": 0,
  "x": 880,
  "y": 120,
  "wires": [
   [
    "c1"
   ],
   [
    "c2"
   ],
   [
    "gauge"
   ],
   [
    "status"
   ],
   [
    "info"
   ]
  ]
 },
